# ============================================================
# D AI Assistant — Backend Environment Variables
# Copy to .env and fill in real values before running.
# ============================================================

# --- Application ---
APP_NAME=D
APP_ENV=development                      # development | staging | production
APP_DEBUG=true                           # Enable debug mode (disable in production)
APP_VERSION=0.1.0

# --- Server ---
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://d_user:d_password@localhost:5432/d_db

# --- JWT Authentication ---
JWT_SECRET_KEY=CHANGE-ME-to-a-random-64-char-hex-string   # openssl rand -hex 32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30       # Access token TTL in minutes
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7          # Refresh token TTL in days

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]  # JSON list of allowed origins

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60                 # Max requests per minute per client

# --- Logging ---
LOG_LEVEL=INFO                           # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                          # json | console

# --- OpenAI (proxied through backend) ---
OPENAI_API_KEY=sk-CHANGE-ME
OPENAI_MODEL=gpt-4o

# --- External Services (optional) ---
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
